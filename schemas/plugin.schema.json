{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HindSight Extension Manifest v2",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "api_version",
    "entry"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "maxLength": 64
    },
    "api_version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "entry": {
      "type": "string",
      "pattern": "^[^/].*\\.py$"
    },
    "capabilities": {
      "type": "array",
      "maxItems": 48,
      "items": {
        "type": "string"
      }
    },
    "events": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "string"
      }
    },
    "commands": {
      "type": "array",
      "maxItems": 48,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,128}$"
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "shortcut": {
            "type": "string",
            "maxLength": 64
          },
          "event": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    },
    "panels": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,128}$"
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "event": {
            "type": "string",
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "maxLength": 512
          },
          "dock": {
            "type": "string",
            "enum": [
              "inspector",
              "bottom"
            ]
          },
          "min_width": {
            "type": "integer",
            "minimum": 160,
            "maximum": 800
          }
        }
      }
    },
    "settings": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,128}$"
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "bool",
              "int",
              "choice"
            ]
          },
          "default_value": {
            "type": "string",
            "maxLength": 4096
          },
          "choices": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 256
            }
          },
          "description": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "analysis_passes": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,128}$"
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "event": {
            "type": "string",
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "debugger_filter": {
      "type": "object",
      "properties": {
        "signals": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          }
        },
        "reasons": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "plugin_id"
        ],
        "properties": {
          "plugin_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,128}$"
          },
          "minimum_version": {
            "type": "string",
            "maxLength": 64
          }
        }
      }
    }
  }
}
